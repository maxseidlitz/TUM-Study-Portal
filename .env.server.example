# Required public URL. Production must be HTTPS and exactly match browser Origin.
PUBLIC_ORIGIN=https://study.example.internal
HOST=127.0.0.1
PORT=3443

# Prefer an Argon2id hash in normal operation. APP_PASSWORD is bootstrap-only.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace-with-generated-hash'
# APP_PASSWORD=replace-only-for-first-bootstrap
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-at-least-32-random-characters

DATABASE_PATH=/var/lib/tum-study-portal/study-portal.sqlite
BACKUP_DIR=/var/lib/tum-study-portal/backups
# Generate each key with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=replace-with-base64-32-byte-key
BACKUP_KEY=replace-with-different-base64-32-byte-key
BACKUP_RETENTION=7
IMPORT_RATE_LIMIT=3
MAX_IMPORT_BYTES=10485760
MAX_JSON_BYTES=1048576
IMPORT_MAX_EXAMS=10000
IMPORT_MAX_LECTURES=50000
IMPORT_MAX_TODOS=50000
IMPORT_MAX_MOODLE_COURSES=10000
IMPORT_MAX_MODULES=10000
IMPORT_MAX_STUDY_LOGS=100000
IMPORT_MAX_CHATS=5000

# Exact lowercase hostnames only, comma separated. No wildcard is accepted.
ICAL_ALLOWED_HOSTS=campus.tum.de
MENSA_CANTEEN_IDS=421,422,423,530

# Browser-provided Ollama URLs are ignored by the server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
# GEMINI_API_KEY=optional-server-owned-key
MAX_AI_CONTEXT_BYTES=65536
MAX_SSE_CONNECTIONS=5

# Set both for direct TLS. Otherwise terminate TLS at a trusted reverse proxy.
# TLS_CERT_PATH=/run/secrets/tls.crt
# TLS_KEY_PATH=/run/secrets/tls.key
# TRUST_PROXY=true
# SESSION_TTL_MS=604800000
# SECURE_COOKIES=true
# LOG_LEVEL=info
