{
  "name": "tum-study-portal",
  "version": "1.0.0",
  "description": "TUM Study Portal - Personal Academic Dashboard for TU München Students",
  "main": "public/electron.js",
  "homepage": "./",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "start": "concurrently \"BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "dev": "concurrently \"BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "test": "react-scripts test --watchAll=false",
    "test:server": "node --test server/test/*.test.js",
    "test:all": "npm test && npm run test:server",
    "build": "react-scripts build",
    "server": "node server/server.js",
    "server:restore": "node server/restore.js",
    "electron": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.3.0",
    "electron-builder": "^24.13.3",
    "react-scripts": "5.0.1",
    "supertest": "^7.2.2",
    "wait-on": "^7.2.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "de.tum.study-portal",
    "productName": "TUM Study Portal",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/ai.js",
      "public/aiRetrieval.js",
      "public/store.js",
      "public/ical.js",
      "public/externalUrl.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/ollama",
        "to": "ollama",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TUM-Study-Portal-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
